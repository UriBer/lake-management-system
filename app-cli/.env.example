# Lake Management System CLI Configuration

# Default BigQuery Project ID
PROJECT_ID=my-project-id

# Update Metadata Configuration
METADATA_TABLE=governance_metadata.test_metadata
JOB_RUN_TABLE=governance_metadata.job_runs
SLEEP_MSECONDS=500
MAX_PARALLEL_WORKERS=10

# Optional: Set default dataset for table-list command
# DEFAULT_DATASET=your-default-dataset

# Dataset Hierarchy - Batch Management (optional)
# Batch management table for automatic batch_id generation (DDMMYYYY-NNNN format)
# BATCH_MGMT_TABLE=governance_metadata.batch_management

# BigQuery Alerts Configuration (optional)
# Alerts table for storing size change alerts
# ALERTS_TABLE=governance_metadata.size_alerts

# Alert Thresholds (optional - defaults shown)
# ALERT_SIZE_INCREASE_PERCENT=20.0
# ALERT_SIZE_INCREASE_ABSOLUTE_GB=10.0
# ALERT_TOTAL_BYTES_PERCENT=20.0
# ALERT_TOTAL_BYTES_ABSOLUTE_GB=10.0
# ALERT_NUM_TABLES_PERCENT=10.0
# ALERT_NUM_DATASETS_PERCENT=5.0
# ALERT_TOTAL_ROWS_PERCENT=20.0
# ALERT_CRITICAL_PERCENT=100.0
# ALERT_CRITICAL_ABSOLUTE_GB=50.0
# ALERT_HIGH_PERCENT=50.0
# ALERT_HIGH_ABSOLUTE_GB=20.0
# ALERT_MEDIUM_PERCENT=20.0
# ALERT_MEDIUM_ABSOLUTE_GB=10.0
# ALERT_ON_LOW=false
